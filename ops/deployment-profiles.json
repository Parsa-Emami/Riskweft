{
  "version": "0",
  "project": "RiskWeft",
  "status": "web_foundation",
  "primary_mode": "browser-local-web",
  "domain_profile": {
    "public_demo": "synthetic-only",
    "admit_untrusted_runtime_jobs": false,
    "enable_sensitive_data_upload_by_default": false,
    "https_required": true
  },
  "private_profile": {
    "single_owner": true,
    "persistent_local_volume": false,
    "use_external_database_service": false,
    "providers": [
      "TypeScript domain engine",
      "React UI",
      "Web Worker evaluation",
      "PWA static hosting"
    ]
  },
  "capacity_targets": {
    "components": 200,
    "flows": 500,
    "import_max_mib": 10,
    "rule_deadline_seconds": 5
  },
  "measured": false,
  "engine_mode": "browser-local",
  "web": {
    "artifact": "dist/release",
    "listen": "127.0.0.1",
    "port": 4302,
    "https_proxy": "ops/web/nginx.conf.template",
    "service": "ops/web/service.systemd",
    "engine_enabled": false,
    "private_admission": "deny-all until operator sets trusted network ranges",
    "offline": false
  }
}
