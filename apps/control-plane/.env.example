# apps/control-plane local development template.
# Copy to .env and fill SECRET_LOCAL_* values; never commit .env.
#
# The keys below that also appear in ../../contracts/config.schema.json (and
# ../../.env.example at the repository root) are RiskWeft's documented
# configuration contract and are validated against that schema in CI
# (see tests/Feature/Config/ConfigSchemaComplianceTest.php).
# A small set of framework-only keys (APP_KEY, APP_DEBUG, APP_URL, DB_*
# connection *names*, CACHE_STORE, SESSION_DRIVER, QUEUE_CONNECTION) exist
# purely to wire Laravel itself and are intentionally out of that schema.

APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

SERVICE_NAME=riskweft

# Secret *references*, not raw credentials (see spec/11_CONFIGURATION_REFERENCE.md).
# The "local" resolver maps secret://local/<name> to env var SECRET_LOCAL_<NAME>.
DATABASE_DSN_REF=secret://local/postgres-dsn
VALKEY_DSN_REF=secret://local/valkey-dsn

# Local-only resolved values for the "local" secret provider (gitignored via .env).
SECRET_LOCAL_POSTGRES_DSN=pgsql://riskweft:riskweft@127.0.0.1:5432/riskweft
SECRET_LOCAL_VALKEY_DSN=redis://127.0.0.1:6379/0

OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
LOG_LEVEL=info
CANONICAL_HASH_ALGORITHM=sha256
RULESET_PATH=./rules
MAX_ARCHITECTURE_BYTES=2097152

CACHE_STORE=redis
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
