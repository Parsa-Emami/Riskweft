# The repository-root .gitignore's /vendor/ and /node_modules/ patterns are
# anchored to the repo root (git semantics for a leading slash) and do not
# reach this nested app, so this app keeps its own copy of the patterns it
# actually needs.
/vendor/
/node_modules/
/.phpunit.cache/
/build/
/public/hot
/public/storage
/storage/*.key
/storage/pail
