              "merge.conflict_created.v1"
            ]
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "subject": {
            "type": "string"
          },
          "traceparent": {
            "type": [
              "string",
              "null"
            ]
          },
          "datacontenttype": {
            "type": "string",
            "const": "application/json"
          },
          "data": {
            "type": "object"
          }
        }
