            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "base_revision_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "architecture": {
                    "type": [
                      "object",
                      "array"
                    ]
                  }
                },
                "required": [
                  "base_revision_id",
                  "architecture"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
